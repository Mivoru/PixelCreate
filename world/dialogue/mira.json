    "prologue_arrive": {
      "text": "Welcome to the Adventurers Guild! ...Oh. Oh, you're Lightborn. And you're... Nell? The Company's Nell?",
      "face": "surprised",
      "options": [
        {
          "text": "She's with me. She needs help.",
          "tone": "compassionate",
          "next": "prologue_hide",
          "effects": [
            {
              "trust": {
                "mira": 5
              }
            },
            {
              "trust": {
                "nell": 3
              }
            }
          ]
        },
        {
          "text": "The Company bought her. I don't know what to do.",
          "tone": "pragmatic",
          "next": "prologue_hide_unsure"
        }
      ]
    },
    "prologue_hide": {
      "text": "Then we'd better be quick and quiet. Into the storeroom, Nell. Nobody goes there but Hollis, and Hollis doesn't talk.",
      "options": [
        {
          "text": "Thank you, Mira.",
          "next": "prologue_law"
        }
      ]
    },
    "prologue_arrive_alone": {
      "text": "Welcome to the Adventurers Guild! ...Oh. You're Lightborn. You came down at the lake, didn't you? And walked out past the finders.",
      "face": "surprised",
      "options": [
        {
          "text": "They had me in a cage. Goblins broke it.",
          "tone": "pragmatic",
          "next": "prologue_law"
        },
        {
          "text": "Is that a problem?",
          "tone": "hard",
          "next": "prologue_law"
        }
      ]
    },
    "prologue_hide_unsure": {
      "text": "Nobody here knows what to do about the Company. But not today. Storeroom, Nell.",
      "options": [
        {
          "text": "...",
          "next": "prologue_law"
        }
      ]
    },
    "prologue_law": {
      "text": "Registration makes you ours in the eyes of the law. Finders can't touch a registered adventurer. And the Anchor Stone will know you. Touch it, by the door. If you fall, you'll wake here, not at the lake.",
      "options": [
        {
          "text": "I'll touch the stone.",
          "effects": [
            {
              "setFlag": "prologue.met_mira"
            }
          ]
        }
      ]
    },
    "prologue_trial": {
      "text": "Good. Now the trial. Rhea will test you. Everyone goes through Rhea.",
      "face": "smile",
      "options": [
        {
          "text": "I'm ready.",
          "effects": [
            {
              "action": "beginTrial"
            }
          ]
        }
      ]
    },
    "prologue_badge_alone": {
      "text": "Adventurer, rank F. Welcome. Finders can't touch you now. Don't give them a reason to try.",
      "face": "smile",
      "options": [
        {
          "text": "I won't.",
          "effects": [
            {
              "setFlag": "prologue.done"
            }
          ]
        }
      ]
    },
    "prologue_badge": {
      "text": "Adventurer, rank F. Welcome. And now the hard part. Sooner or later the Company will come asking about a girl.",
      "face": "smile",
      "options": [
        {
          "text": "Then we'll be ready.",
          "effects": [
            {
              "setFlag": "prologue.done"
            }
          ]
        }
      ]
    }
