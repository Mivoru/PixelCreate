    "register": {
      "text": "Welcome to the Adventurers Guild. Looking for work? Sign here and you're rank F: the board's jobs are yours, and the Guild buys every magic crystal you bring.",
      "face": "smile",
      "options": [
        {
          "text": "Sign me up.",
          "effects": [
            {
              "action": "register"
            },
            {
              "quest": {
                "complete": "prologue_fallen"
              }
            }
          ],
          "next": "registered"
        },
        {
          "text": "Not yet."
        }
      ]
    },
    "turn_in_slime_cull": {
      "text": "Well done! Here is your pay for Clear the Slimes: 40 gold.",
      "face": "smile",
      "options": [
        {
          "text": "Hand in the job",
          "effects": [
            {
              "quest": {
                "complete": "slime_cull"
              }
            }
          ]
        },
        {
          "text": "Sell all crystals ({crystalWorth} gold)",
