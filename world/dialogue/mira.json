    "register": {
      "text": "Welcome to the Adventurers Guild! To register you must pass a trial against one of our staff.",
      "face": "smile",
      "options": [
        {
          "text": "Take the trial",
          "effects": [
            {
              "action": "beginTrial"
            }
          ]
        },
        {
          "text": "Not yet"
        }
      ]
    },
    "turn_in_slime_cull": {
      "text": "Well done! Here is your pay for Clear the Slimes: 40 gold.",
      "face": "smile",
      "options": [
        {
          "text": "Hand in the job",
          "effects": [
            {
              "quest": {
                "complete": "slime_cull"
              }
            }
          ]
        },
        {
          "text": "Sell all crystals ({crystalWorth} gold)",
